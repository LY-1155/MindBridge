OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=http://localhost:8000/v1
MODEL_NAME=qwen3.7-max

# MySQL — Docker 环境 MYSQL_HOST 用 mysql（容器名），本地开发用 localhost
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=prism_db
USE_DATABASE=true

REDIS_URL=redis://localhost:6379/0
DEBUG=true

# JWT — 生产必须替换（生成：openssl rand -hex 32）
JWT_SECRET_KEY=change-me-to-a-random-secret

# 听写：sensevoice（需 pip install funasr modelscope）或 whisper
ASR_BACKEND=sensevoice
SENSEVOICE_ASR_MODEL=iic/SenseVoiceSmall


# 文本情绪引擎：keyword（默认）/ onnx（需先 python scripts/download_emotion_model.py）
EMOTION_ENGINE=keyword
# EMOTION_ONNX_MODEL_PATH=models/emotion_classifier/model.onnx
# EMOTION_ONNX_TOKENIZER_PATH=

AUDIO_EMOTION_BACKEND=sensevoice
VISUAL_EMOTION_BACKEND=emotiefflib
ENABLE_MULTIMODAL_EMOTION_FUSION=true

# 字段级 AES-256-GCM 加密密钥（生产必须为 32 字节随机串，生成：openssl rand -base64 32）
# 加密范围：messages.content、emotion_records.context、safety_flags.matched_terms
ENCRYPTION_KEY=change-me-to-a-32-byte-random-key

# 紧急推送配置（dry-run 模式默认关闭，生产前改为 true 并填入真实 API 地址）
EMERGENCY_PUSH_ENABLED=false
EMERGENCY_RESCUE_API_URL=
EMERGENCY_RESCUE_API_KEY=
EMERGENCY_PUSH_COOLDOWN_SECONDS=300

# CRITICAL 告警 Webhook（钉钉/飞书机器人 — 生产前填入真实 URL 并设置 enabled=true）
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_DINGTALK_URL=
ALERT_WEBHOOK_FEISHU_URL=

