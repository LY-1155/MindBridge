{
  "name": "MDQ",
  "display_name": "心境障碍问卷",
  "description": "13条目自评筛查，评估一生中是否有过躁狂或轻躁狂症状期。每项是非题，阳性标准：Q1≥7个「是」AND Q2=「是」AND Q3≥中度问题。灵敏度70%，特异度90%。",
  "scoring_mode": "mdq",
  "positive_rule": {
    "q1_yes_min": 7,
    "q2_required": true,
    "q3_min_level": 2
  },
  "items": [
    {
      "index": 0,
      "dimension": "情绪高涨/过度活跃",
      "concept": "你是否曾有一段时间自己感觉异常的好或异常活跃，以至于别人认为你与平时不一样，或你因为过度活跃而惹上麻烦？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 1,
      "dimension": "易怒",
      "concept": "你是否曾有一段时间非常易怒，对人大吼大叫或引发争吵打斗？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 2,
      "dimension": "自信心膨胀",
      "concept": "你是否曾有一段时间比平时更加自信？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 3,
      "dimension": "睡眠减少",
      "concept": "你是否曾有一段时间比平时睡得少很多，而且并不觉得需要多睡？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 4,
      "dimension": "话多/语速快",
      "concept": "你是否曾有一段时间比平时话多很多，或说话速度比平时快很多？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 5,
      "dimension": "思维奔逸",
      "concept": "你是否曾有一段时间感到脑子里的想法飞快闪现，或无法让思绪慢下来？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 6,
      "dimension": "注意力分散",
      "concept": "你是否曾有一段时间很容易被周围事物分散注意力，以至于难以集中注意力或无法维持做事的方向？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 7,
      "dimension": "精力充沛",
      "concept": "你是否曾有一段时间比平时精力充沛得多？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 8,
      "dimension": "活动增多",
      "concept": "你是否曾有一段时间比平时活跃得多或做了比平时多得多的事情？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 9,
      "dimension": "社交增多",
      "concept": "你是否曾有一段时间比平时社交更多或有更多外向举动，例如半夜给朋友打电话？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 10,
      "dimension": "性欲增强",
      "concept": "你是否曾有一段时间比平时对性的兴趣大得多？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 11,
      "dimension": "冒险行为",
      "concept": "你是否曾有一段时间做了对自己来说不寻常的事，或他人可能认为是过度、愚蠢或冒险的事？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 12,
      "dimension": "过度消费",
      "concept": "你是否曾有一段时间花钱让你或你的家庭陷入麻烦？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 13,
      "dimension": "症状同期发生",
      "concept": "如果你在第1-13题中勾选了不止一个「是」，这些症状是否在同一段时间内发生过？",
      "anchors": {
        "0": "否",
        "1": "是"
      }
    },
    {
      "index": 14,
      "dimension": "问题严重程度",
      "concept": "以上症状给你造成了多大程度的问题，例如无法工作、家庭/金钱/法律麻烦、争吵或打架？",
      "anchors": {
        "0": "没有问题",
        "1": "轻微问题",
        "2": "中度问题",
        "3": "严重问题"
      }
    }
  ],
  "thresholds": [
    {"min": 0, "max": 6, "level": "阴性筛查", "label": "negative"},
    {"min": 7, "max": 13, "level": "可能阳性（需同时验证Q2和Q3）", "label": "potential_positive"}
  ],
  "escalation": {
    "total_score_threshold": 7,
    "item_triggers": [11, 12],
    "item_threshold": 1
  }
}
